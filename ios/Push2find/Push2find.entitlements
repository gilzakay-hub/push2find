<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Phase 1: intentionally empty so the app can be signed with any Apple ID,
	including a free one (Xcode personal team / Sideloadly).

	Phase 2 (paid Apple Developer account), add:
	  <key>com.apple.developer.usernotifications.time-sensitive</key><true/>
	Phase 3 (after Apple approves Critical Alerts), also add:
	  <key>com.apple.developer.usernotifications.critical-alerts</key><true/>
	and set AppConfig.criticalAlertsEnabled = true.
	-->
</dict>
</plist>
